# Copy this file to .env and fill in the values. Never commit .env.

# Key used to sign session tokens (JWTs). Anyone who knows it can log in as any user.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
CLOUDLESS_SECRET_KEY=

# Set to true when serving over HTTPS, so the session cookie is never sent over plain http.
CLOUDLESS_SECURE_COOKIES=false

# Maximum upload size in MB. Leave empty for no limit.
CLOUDLESS_MAX_UPLOAD_MB=
